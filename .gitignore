.venv/
.env
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
*.sqlite
*.sqlite.lock
# WAL sidecars: journal_mode=WAL leaves these next to any open projection,
# and the *.sqlite rule does not match them.
*.sqlite-wal
*.sqlite-shm
*.jsonl

# hand-maintained CbetaReader search index (HANDOFF.md step 4): entry_path ->
# known excerpts. The excerpts are corpus bytes copied from the real CBETA
# archive and must never be committed, same rule as the archive itself.
cbeta_index.json

# Frontend (stage 5). `src/`, package.json and package-lock.json are tracked;
# the dependency tree and the compiled bundle are not — `npm run build`
# regenerates cohort/ui/static/ from them.
cohort/ui/frontend/node_modules/
cohort/ui/static/

# Researcher data (Radich / CHAI-Heidelberg). Licence-restricted and personal:
# the CBETA-derived corpus is CC BY-NC-SA-equivalent, not public domain, and the
# mail PDF carries participants' addresses. This repository is public — corpus
# bytes and correspondence never enter it, same rule as the CBETA archive above.
data/
*.zip
wget-log
