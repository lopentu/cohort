# Copy to .env.docker (ignored). Paths here are CONTAINER paths.
# Empty defaults start only Graph and Findings. No example research is seeded.
LOCAL_CORPUS_ROOT=
LOCAL_CORPUS_MANIFEST=
COHORT_RADICH_ROOT=
EVIDENCE_EMBEDDINGS_PATH=
CBETA_ARCHIVE_PATH=
CBETA_FTS_PATH=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_MODELS=
OPENROUTER_REASONING_EFFORT=
# For data/radich on the host:
# LOCAL_CORPUS_ROOT=/inputs/radich/corpus/T-stripped
# COHORT_RADICH_ROOT=/inputs/radich
# EVIDENCE_EMBEDDINGS_PATH=/inputs/embeddings/windows.npz

# Used by Compose too: always pass --env-file .env.docker.
# Keep both capabilities opt-in. Agent runs can incur API charges.
COHORT_ALLOW_WRITES=0
COHORT_ALLOW_RUNS=0
# Explicit opt-out of the native per-run monetary threshold (0 retains it).
COHORT_NO_BUDGET=0
COHORT_PORT=18766
# Account setup instructions append your host UID/GID to this file.
