# Non-secret settings; install at /etc/lope/services/cohort/cohort.env.
# Set an immutable reviewed image digest, or a revision-specific local tag.
COHORT_IMAGE=
COHORT_UID=
COHORT_GID=
COHORT_PORT=18766
COHORT_ROOT_PATH=/cohort
COHORT_PUBLIC_ORIGIN=https://lopen.linguistics.ntu.edu.tw
COHORT_TRUSTED_PROXY_IPS=127.0.0.1
COHORT_ALLOW_WRITES=1
COHORT_ALLOW_RUNS=1
COHORT_NO_BUDGET=0
COHORT_RADICH_ROOT=/inputs/radich
LOCAL_CORPUS_ROOT=/inputs/radich/corpus/T-stripped
EVIDENCE_EMBEDDINGS_PATH=/embeddings/mitra-qwen35-embedder.npz
# Model selection must match the preserved existing settings.
# OPENROUTER_MODEL and OPENROUTER_MODELS can be set here;
# API credentials belong in /etc/lope/secrets/cohort/model.env.
