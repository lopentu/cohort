OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional. Comma-separated pool for multi-agent runs. Agents in one run may
# not share a model family, because two agents on one model share priors and
# their agreement would be one observation reported twice. One model per
# agent, from distinct providers:
#   OPENROUTER_MODELS=deepseek/deepseek-v4-flash,qwen/qwen3.8-27b
OPENROUTER_MODELS=
# Path to the hash-verified CBETA archive (never committed; see docs/corpus.md).
CBETA_ARCHIVE_PATH=
# Optional. Where the full-corpus FTS index lives, built by
# scripts/build_cbeta_index.py. Defaults to cbeta_fts.sqlite in the repo root,
# which the existing *.sqlite ignore rule already keeps out of git.
CBETA_FTS_PATH=
# Optional. Pin a different CBETA build than v061 (e.g. the xml-p5 repository
# at a tag, re-zipped into the Bookcase/CBETA/XML/ layout) by its own hash, and
# say which build it is: the label travels on every witness's provenance note.
CBETA_ARCHIVE_SHA256=
CBETA_ARCHIVE_VERSION=
# Alternative to the CBETA archive: a folder of plain-text files with a
# manifest.csv (see cohort/sources/local_reader.py). Takes precedence when set.
# For Radich's corpus: python scripts/radich_manifest.py data/radich, then
#   LOCAL_CORPUS_ROOT=data/radich/corpus/T-stripped
LOCAL_CORPUS_ROOT=
LOCAL_CORPUS_MANIFEST=
# Optional. Output-token ceiling per model call (default 2800; 0 = none -- the
# per-run dollar budget remains the hard stop) and reasoning effort
# (low/medium/high) for models that think before they write.
OPENROUTER_MAX_OUTPUT_TOKENS=
OPENROUTER_REASONING_EFFORT=
# Optional. Precomputed window embeddings (.npz with vec/uid/label/start) for
# the semantic_neighbors agent tool; needs `uv sync --extra evidence`.
EVIDENCE_EMBEDDINGS_PATH=
